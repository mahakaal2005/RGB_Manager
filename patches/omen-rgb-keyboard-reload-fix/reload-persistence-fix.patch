 struct led_classdev omen_kbd_led;
 
@@ -113,7 +114,7 @@ void update_all_zones_with_colors(struct color_platform colors[ZONE_COUNT])
 	}
 }
 
-static int omen_apply_brightness(unsigned long level)
+int omen_apply_brightness(unsigned long level)
 {
 	int ret;
 
@@ -132,7 +133,12 @@ static int omen_apply_brightness(unsigned long level)
 			return ret;
 	}
 
-	save_animation_state();
+	/*
+	 * Don't persist the LED-core's shutdown-time brightness=0 write
+	 * (see driver_unloading in omen_zones.h) over the real saved state.
+	 */
+	if (!driver_unloading)
+		save_animation_state();
 	return 0;
 }
 
